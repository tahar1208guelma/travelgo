#include <windows.h>
#include "resource.h"

IDI_APP_ICON            ICON                    "resources\\app_icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,1
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TRAVELGO Inc."
            VALUE "FileDescription", "TRAVELGO Travel Booking Platform"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "travelgo"
            VALUE "LegalCopyright", "Copyright (C) 2026 TRAVELGO Inc. All rights reserved."
            VALUE "OriginalFilename", "travelgo.exe"
            VALUE "ProductName", "TRAVELGO"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
