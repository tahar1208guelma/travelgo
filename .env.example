# =============================================================================
# TravelGo Platform Environment Configuration
# NEVER commit raw credentials, secrets or production API keys to git.
# Copy this file to .env and fill in real values.
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
CORS_ORIGIN=*
RATE_LIMIT_MAX=200

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travelgo

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_string_for_production
JWT_EXPIRES_IN=7d

# Dynamic Platform Commission (Default 0.75% = 0.0075)
COMMISSION_RATE=0.0075

# -----------------------------------------------------------------------------
# 1. Flight Providers (Keep on Backend ONLY - NEVER expose to Flutter)
# -----------------------------------------------------------------------------
# Amadeus Travel API (https://developers.amadeus.com)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Duffel Flights API (https://duffel.com)
DUFFEL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# 2. Hotel Providers (Keep on Backend ONLY - NEVER expose to Flutter)
# -----------------------------------------------------------------------------
# Booking.com Affiliate API
BOOKING_COM_API_KEY=

# Expedia Partner Solutions API
EXPEDIA_API_KEY=
EXPEDIA_API_SECRET=

# -----------------------------------------------------------------------------
# 3. Payment Gateways (Keep on Backend ONLY)
# -----------------------------------------------------------------------------
# Stripe Global Gateway (https://stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Algeria SATIM / CIB & Edahabia Gateway (https://satim.dz)
CIB_MERCHANT_KEY=
CIB_TERMINAL_ID=
