# =============================================================================
# TravelGo Platform Environment Configuration Template (.env.example)
# =============================================================================
# NOTE: Never commit sensitive credentials or live API keys to version control.
# Copy this template to .env and configure values securely in your environment.

# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# PostgreSQL Database Connection URL (Supabase / Self-hosted)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/travelgo

# Supabase Gateway Configuration (Zero Client Secrets: client uses anon_key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_backend_only_service_role_key_here

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_byte_string_for_jwt_signing
JWT_EXPIRES_IN=7d

# Dynamic Platform Commission Settings
# Default Direct Service Fee: $1.00 USD
# Affiliate Service Fee: $0.00 USD
# Default Percentage Model: 0.75% = 0.0075
COMMISSION_RATE=0.0075
STANDARD_DIRECT_FEE_USD=1.00
STANDARD_AFFILIATE_FEE_USD=0.00
HOTEL_PARTNER_COMMISSION_RATE=0.12

# Flight Aggregator Providers (Backend-only credentials)
AMADEUS_CLIENT_ID=your_amadeus_api_key_backend_only
AMADEUS_CLIENT_SECRET=your_amadeus_secret_backend_only
AMADEUS_ENVIRONMENT=test
DUFFEL_ACCESS_TOKEN=duffel_test_your_token_backend_only

# Hotel Inventory Providers (Backend-only credentials)
BOOKING_COM_API_KEY=your_bookingcom_key_backend_only
EXPEDIA_API_KEY=your_expedia_key_backend_only
EXPEDIA_API_SECRET=your_expedia_secret_backend_only

# Payment Gateways (Backend-only credentials)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_backend_only
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_backend_only
PAYPAL_CLIENT_ID=your_paypal_client_id_backend_only
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_backend_only
CIB_MERCHANT_KEY=your_cib_merchant_key_backend_only
CIB_TERMINAL_ID=your_cib_terminal_id_backend_only
